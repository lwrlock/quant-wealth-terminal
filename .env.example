# Master PIN for first boot (default: 1234 if omitted)
MASTER_PIN=1234

# Optional 64-char hex secret for signing session cookies
SESSION_SECRET=

# Optional Telegram Bot Token & Webhook Secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional Turso / LibSQL Cloud Snapshot Sync
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional Gemini / OpenAI / Anthropic / Ollama configuration
GEMINI_API_KEY=
